NODE_ENV=development
PORT=4000

# PostgreSQL connection (managed instance in prod — Render/Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alia_noori_dev

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# The deployed frontend's origin, e.g. https://your-app.vercel.app — added
# on top of CORS_ORIGIN (which stays the local-dev default above) rather
# than replacing it. Leave unset in local dev. See docs/DEPLOYMENT.md.
# FRONTEND_URL=

# Admin AI assistant (/api/assistant, admin role only). Uses any
# OpenAI-compatible chat API with tool calling — Groq by default. Leave the
# key unset to run with the assistant disabled. Server-side only — never
# put it in the frontend's env, where Next.js could ship it to the browser.
# Variable names are case-sensitive on Linux: GROQ_API_KEY, not Groq_API_KEY.
# GROQ_API_KEY=
# ASSISTANT_MODEL=openai/gpt-oss-120b
# ASSISTANT_REASONING_EFFORT=medium
# Reads attached receipts/invoices; must accept image input (same key and provider):
# ASSISTANT_VISION_MODEL=qwen/qwen3.8-27b
# Another provider instead of Groq:
# ASSISTANT_BASE_URL=https://api.example.com/v1
# ASSISTANT_API_KEY=
