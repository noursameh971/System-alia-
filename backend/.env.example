NODE_ENV=development
PORT=4000

# PostgreSQL connection (managed instance in prod — Render/Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alia_noori_dev

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API (the Next.js app)
CORS_ORIGIN=http://localhost:3000

# TEMPORARY, local dev only: when true, every request is treated as an
# authenticated admin with no token required — lets you hit the API from
# Postman before the login/JWT-issuance module exists. Override per-request
# with the x-mock-user-id / x-mock-role headers. Refused at startup if
# NODE_ENV=production. Delete this once real auth ships.
AUTH_BYPASS=false
