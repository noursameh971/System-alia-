# Base URL of the backend API (see ../backend)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must be the EXACT same value as backend/.env's JWT_SECRET — proxy.ts
# verifies the session cookie's signature at the edge with this secret, and
# the token was signed by the backend with it. A mismatch means every
# request looks unauthenticated (safe-fail, but nothing will work).
JWT_SECRET=replace-with-a-long-random-string

# Shows the AI assistant (floating button, Ctrl/Cmd+K, Settings > Knowledge base).
# Hidden unless exactly "true" — see src/lib/features.ts.
NEXT_PUBLIC_ASSISTANT_ENABLED=false
